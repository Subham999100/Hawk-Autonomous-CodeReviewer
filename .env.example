# ==============================================================================
# Hawk — Autonomous Engineering Investigation Platform Configuration Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
DEBUG=false

# Database Configuration (PostgreSQL in Production, SQLite for Local Testing)
DATABASE_URL=postgresql+asyncpg://hawk:hawk_secure_password@localhost:5432/hawk_db
DATABASE_SYNC_URL=postgresql://hawk:hawk_secure_password@localhost:5432/hawk_db

# Background Queue & Event Bus (Redis)
REDIS_URL=redis://localhost:6379/0

# Authentication & Authorization (Managed IdP or Internal JWT Engine)
AUTH_PROVIDER=jwt
AUTH_SECRET_KEY=hawk-super-secret-development-key-change-in-production-32chars
AUTH_ALGORITHM=HS256
AUTH_ACCESS_TOKEN_EXPIRE_MINUTES=1440
# Optional OIDC / JWKS for external IdP (Supabase / Clerk / Auth0)
AUTH_JWKS_URL=
AUTH_ISSUER=
AUTH_AUDIENCE=

# AI Reasoning Service (OpenAI)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-5-mini

# GitHub Access (Optional Personal Access Token to raise API rate limits from 60 to 5000 req/hr)
GITHUB_TOKEN=

# Orchestration Decision Layer (TypeSafe AI Jev System One API)
JEV_API_KEY=your_typesafe_jev_api_key_here
JEV_API_BASE_URL=https://api.typesafe.ai/v1/systemone
JEV_MODEL=jev-latest

# Engineering Memory (Obsidian Local REST API)
OBSIDIAN_API_URL=https://127.0.0.1:27124
OBSIDIAN_API_KEY=your_obsidian_local_rest_api_key_here
OBSIDIAN_VAULT_SUBPATH=Hawk/investigations

# Task Bounds & Failure Recovery
TASK_TIMEOUT_SECONDS=300
MAX_RETRIES=3
